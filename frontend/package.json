{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "dev:pc": "vite --port 5173 --host --mode pc",
    "dev:mobile": "vite --port 5174 --host --mode mobile",
    "dev:all": "concurrently \"npm run dev:pc\" \"npm run dev:mobile\"",
    "build": "vite build",
    "build:pc": "vite build --mode pc --outDir dist-pc",
    "build:mobile": "vite build --mode mobile --outDir dist-mobile",
    "build:all": "npm run build:pc && npm run build:mobile",
    "lint": "eslint .",
    "preview": "vite preview --host --port 4173",
    "preview:pc": "vite preview --port 4173 --outDir dist-pc --host",
    "preview:mobile": "vite preview --port 4174 --outDir dist-mobile --host",
    "preview:all": "concurrently \"npm run preview:pc\" \"npm run preview:mobile\""
  },
  "dependencies": {
    "@capacitor/android": "^8.4.0",
    "@capacitor/core": "^8.4.0",
    "@capacitor/push-notifications": "^8.1.1",
    "apexcharts": "^5.10.6",
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.5",
    "framer-motion": "^12.38.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^1.8.0",
    "react": "^19.2.4",
    "react-apexcharts": "^2.1.0",
    "react-dom": "^19.2.4",
    "react-hot-toast": "^2.6.0",
    "react-icons": "^5.6.0",
    "react-is": "^19.2.5",
    "react-router-dom": "^7.14.1",
    "recharts": "^3.8.1",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.0",
    "@eslint/js": "^9.39.4",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "postcss": "^8.5.9",
    "tailwindcss": "^4.2.2",
    "vite": "^8.0.4",
    "vite-plugin-pwa": "^1.2.0"
  }
}
